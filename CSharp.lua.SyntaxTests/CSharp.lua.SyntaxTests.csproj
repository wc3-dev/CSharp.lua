<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- .NET 10, as Moonwell's build: CSharp.lua compiles against the libraries of the runtime it runs on, and .NET 6's pick other overloads. -->
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="MSTest.TestAdapter" Version="2.2.10" />
    <PackageReference Include="MSTest.TestFramework" Version="2.2.10" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Cases\**" />
    <None Remove="Cases\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CSharp.lua\CSharp.lua.csproj" />
    <ProjectReference Include="..\CSharp.lua.CoreSystem\CSharp.lua.CoreSystem.csproj" />
  </ItemGroup>

</Project>
